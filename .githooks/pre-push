#!/bin/sh
# push の前に関門を通す。落ちたら push しない。
# 有効化（初回だけ）:  git config core.hooksPath .githooks
# どうしても飛ばすとき:  SKIP_GATE=1 git push   （理由をコミットメッセージに書くこと）
[ -n "$SKIP_GATE" ] && { echo "[pre-push] SKIP_GATE=1 で関門を飛ばした"; exit 0; }
cd "$(git rev-parse --show-toplevel)" || exit 1
node tools/gate.mjs || { echo; echo "[pre-push] 関門で止めた。直してから push すること。"; exit 1; }
